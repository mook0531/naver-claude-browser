{
  "manifest_version": "0.3",
  "name": "naver-browser",
  "display_name": "네이버 + Claude 브라우저",
  "version": "1.5.0",
  "description": "내 컴퓨터의 '네이버 + Claude 브라우저' 창을 Claude가 조작해 네이버 검색·네이버 부동산 정보를 가져옵니다.",
  "long_description": "네이버 검색, 네이버 뉴스·블로그·카페, 네이버 부동산(land.naver.com) 정보가 필요할 때 Claude가 사용자의 컴퓨터에 설치된 '네이버 + Claude 브라우저' 앱을 직접 조작합니다. 브라우저 앱이 꺼져 있으면 자동으로 실행합니다. 이 확장 프로그램은 브라우저 앱과 내 컴퓨터 안(127.0.0.1)에서만 통신합니다.",
  "author": {
    "name": "mook0531"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mook0531/naver-claude-browser"
  },
  "server": {
    "type": "node",
    "entry_point": "server/index.js",
    "mcp_config": {
      "command": "node",
      "args": [
        "${__dirname}/server/index.js"
      ],
      "env": {}
    }
  },
  "tools": [
    {
      "name": "naver_search",
      "description": "네이버 검색 후 결과 페이지의 글을 돌려줍니다"
    },
    {
      "name": "naver_shopping_search",
      "description": "네이버 쇼핑 상품 검색(공식 API)"
    },
    {
      "name": "navigate",
      "description": "주소 열기, 뒤로/앞으로/새로고침"
    },
    {
      "name": "get_page_text",
      "description": "현재 페이지의 글 전체 읽기"
    },
    {
      "name": "read_page",
      "description": "누를 수 있는 요소 목록을 번호(ref)와 함께 읽기"
    },
    {
      "name": "find",
      "description": "설명에 맞는 요소 찾기"
    },
    {
      "name": "click",
      "description": "요소 클릭"
    },
    {
      "name": "type_text",
      "description": "글자 입력"
    },
    {
      "name": "press_key",
      "description": "키 누르기"
    },
    {
      "name": "scroll",
      "description": "스크롤"
    },
    {
      "name": "scroll_to",
      "description": "요소가 보이도록 스크롤"
    },
    {
      "name": "set_value",
      "description": "입력창·선택상자 값 설정"
    },
    {
      "name": "screenshot",
      "description": "화면 캡처"
    },
    {
      "name": "list_tabs",
      "description": "열린 탭 목록"
    },
    {
      "name": "new_tab",
      "description": "새 탭 열기"
    },
    {
      "name": "switch_tab",
      "description": "탭 전환"
    },
    {
      "name": "close_tab",
      "description": "탭 닫기"
    },
    {
      "name": "new_window",
      "description": "새 창 열기"
    },
    {
      "name": "list_bookmarks",
      "description": "북마크 목록"
    },
    {
      "name": "add_bookmark",
      "description": "북마크 추가"
    },
    {
      "name": "use_current_tab",
      "description": "사용자가 보고 있는 탭을 작업 대상으로"
    }
  ],
  "keywords": [
    "naver",
    "네이버",
    "부동산",
    "browser"
  ],
  "license": "MIT",
  "compatibility": {
    "platforms": [
      "win32",
      "darwin"
    ],
    "runtimes": {
      "node": ">=18.0.0"
    }
  }
}
